# ==============================================================================
# Environment Configuration Template
# Copy this file to .env and fill in your real values:
# cp .env.example .env
# ==============================================================================

# Google Gemini API Key (From https://aistudio.google.com/)
GEMINI_API_KEY=REDACTED


# Telegram Bot Token (From @BotFather)
TELEGRAM_BOT_TOKEN=REDACTED


# Your Numeric Telegram User ID (From @userinfobot)
# Messages from any other user ID will be rejected
TELEGRAM_ALLOWED_USER_ID=REDACTED

# Database URL (Defaults to local SQLite file)
DATABASE_URL=REDACTED

# Application Environment (REDACTED, testing, production)
APP_ENV=REDACTED
