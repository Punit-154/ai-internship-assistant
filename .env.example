# ==============================================================================
# Environment Configuration Template
# Copy this file to .env and fill in your real values:
# cp .env.example .env
# NEVER put real credentials in this file - it is committed to git.
# ==============================================================================

# Google Gemini API Key (From https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Telegram Bot Token (From @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Your Numeric Telegram User ID (From @userinfobot)
# Messages from any other user ID will be rejected
TELEGRAM_ALLOWED_USER_ID=your_numeric_telegram_user_id

# Database URL (Defaults to local SQLite file)
DATABASE_URL=sqlite:///internships.db

# Application Environment (REDACTED, testing, production)
APP_ENV=REDACTED
